# FIBO Video Director Environment Variables

# Required: Google Gemini API Key for VLM
GOOGLE_API_KEY=your-google-api-key

# Required: FAL.ai API Key for image generation
FAL_KEY=your-fal-api-key

# Optional: S3 bucket for frame caching (auto-created if not exists)
FIBO_S3_BUCKET=fibo-frames-cache

# Optional: AWS credentials (use IAM roles in production)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Optional: Enable enhanced multi-agent director
USE_ENHANCED_DIRECTOR=false
